	<test:TestCase rdf:about="http://owl.semanticweb.org/id/Rdfbased-2Dsem-2Dndis-2Dalldisjointproperties-2Dfw">
		<rdf:type rdf:resource="&test;ProfileIdentificationTest" />
		<rdf:type rdf:resource="&test;InconsistencyTest" />
